### ------------------------------------------------------------
### Sway config (Catppuccin + wofi launcher + rofi power menu)
### Managed by Ansible: roles/baseline_dotfiles/files/config/sway/config
### ------------------------------------------------------------

### Modifier key
set $mod Mod4

### Apps
set $term alacritty
set $menu wofi --show drun

### Font for sway UI (titles, etc). Terminal font is set in Alacritty.
font pango:Hack Nerd Font 10

### ------------------------------------------------------------
### Catppuccin theme
### ------------------------------------------------------------
# If you already deploy Catppuccin files into ~/.config/sway/themes/,
# keep this include and make sure the file exists.
#
# Common patterns:
#   include ~/.config/sway/themes/catppuccin-mocha.conf
#   include ~/.config/sway/themes/mocha.conf
#
# Pick ONE that matches what you deploy.
include ~/.config/sway/catppuccin-mocha

### ------------------------------------------------------------
### Autostart
### ------------------------------------------------------------

# Status bar
exec_always --no-startup-id sh -c 'pkill -x waybar || true; waybar'
#exec_always --no-startup-id waybar

# Display profile switcher (docked/undocked)
#exec_always --no-startup-id kanshi
exec_always --no-startup-id sh -c 'pkill -x kanshi || true; kanshi'

exec_always --no-startup-id sh -c 'sleep 0.5; swaymsg "workspace 1; move workspace to output DP-3"; swaymsg "workspace 2; move workspace to output DP-5"'

# Enforce workspace placement after outputs settle
exec_always --no-startup-id sh -c 'sleep 0.5; ~/.config/sway/scripts/ensure_workspaces.sh'

# Night color (optional; uncomment if installed & desired)
#exec_always --no-startup-id wlsunset -l 35.2271 -L -80.8431 -t 6500 -T 3500

#Notifications
exec_always mako

#Internet
exec_always nm-applet --indicator

# Wallpaper
exec_always --no-startup-id sh -c 'pkill -x swaybg || true; swaybg -i ~/.config/sway/wallpapers/black-hole_wallpaper.png -m fill'
### ------------------------------------------------------------
### Key bindings
### ------------------------------------------------------------

# Terminal
bindsym $mod+Return exec $term

# Firefox
#bindsym $mod+Shift+f exec firefox
bindsym $mod+Shift+f exec swaymsg '[app_id="firefox"] focus' || firefox

# App launcher
bindsym $mod+d exec $menu

# Power menu
bindsym $mod+Shift+e exec ~/.config/sway/scripts/powermenu.sh

# Kill focused window
bindsym $mod+Shift+q kill

# Reload / restart sway
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Exit sway (confirm)
bindsym $mod+Shift+x exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'

# Keybind cheatcheat
bindsym $mod+slash exec --no-startup-id ~/.config/sway/scripts/show-keybinds.sh

# Focus (vim keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move container
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Layout toggles
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Shift+space focus mode_toggle
bindsym $mod+b splith
bindsym $mod+v splitv

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

### ------------------------------------------------------------
### Media keys (optional; requires pamixer/playerctl/brightnessctl)
### ------------------------------------------------------------

bindsym XF86AudioRaiseVolume exec pamixer -i 5
bindsym XF86AudioLowerVolume exec pamixer -d 5
bindsym XF86AudioMute exec pamixer -t

bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

### ------------------------------------------------------------
### Screenshots (optional; requires grim/slurp/wl-clipboard)
### ------------------------------------------------------------

bindsym Print exec grim - | wl-copy
bindsym $mod+Print exec slurp | grim -g - - | wl-copy

### ------------------------------------------------------------
### Input defaults
### ------------------------------------------------------------

input type:touchpad {
  dwt enabled
  tap enabled
  natural_scroll enabled
  middle_emulation enabled
}

input type:keyboard {
  repeat_delay 300
  repeat_rate 40
}

### ------------------------------------------------------------
### Window rules (safe)
### ------------------------------------------------------------

for_window [app_id="pavucontrol"] floating enable
for_window [app_id="blueman-manager"] floating enable

### ------------------------------------------------------------
### Output/workspace pinning (leave to kanshi or add here)
### ------------------------------------------------------------
# If you want fixed workspace->output mapping (like you used before),
# add it here OR put it into a kanshi profile so it only applies docked.
#
# Example:
workspace 1 output DP-3
workspace 2 output DP-5

